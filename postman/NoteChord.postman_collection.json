{
  "info": {
    "_postman_id": "c7f99b12-9c16-4f47-897b-3b6d4ee29801",
    "name": "NoteChord App API",
    "description": "Colección completa de endpoints para NoteChord App. Incluye endpoints de Firebase Authentication y Cloud Firestore REST API para gestión de Usuarios, Carpetas (Folders) y Notas/Cifrados (Notes).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "FIREBASE_API_KEY",
      "value": "AIzaSyA35vP3wruR9ofN2vlGYm5FzJBRiBf1Q_A",
